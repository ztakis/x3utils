<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox intentionally OFF: this self-distributed tool spawns the bundled
	     openocd, reaches the ST-LINK over USB (libusb), and writes backups to
	     ~/x3utils. The App Sandbox blocks all three. (macOS analogue of
	     the Linux udev rule.) -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
